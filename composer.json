{
    "name": "phunkie/phunkiec",
    "description": "Phunkie preprocessor CLI: compiles .phunkie files into standard PHP",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Marcello Duarte",
            "email": "marcello.duarte@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2 || ^8.3 || ^8.4 || ^8.5",
        "phunkie/phunkistan": "dev-main",
        "phunkie/phunkie": "^1.4 || ^2.0",
        "md/syn": "^0.2",
        "symfony/console": "^7.0",
        "symfony/finder": "^7.0",
        "nikic/php-parser": "^5.7"
    },
    "autoload": {
        "psr-4": {
            "Phunkie\\Compiler\\": "src/"
        }
    },
    "bin": [
        "bin/phunkiec"
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "phpspec/phpspec": "9.x-dev"
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/phunkie/phunkistan"
        }
    ]
}
